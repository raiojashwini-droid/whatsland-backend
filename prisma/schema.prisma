model WordPressInquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("wordpress_inquiries")
}

model LeaseRenewal {
  id            String        @id @default(uuid())
  leaseId       String        @unique
  newRentAmount Float
  newEndDate    DateTime
  status        RenewalStatus @default(PENDING)
  termMonths    Int           @default(12)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lease         Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("lease_renewals")
}

enum RenewalStatus {
  PENDING
  OFFER_SENT
  ACCEPTED
  REJECTED
}

model CompanyIntegration {
  id                  String   @id @default(uuid())
  companyId           String
  provider            String   // "TWILIO" or "WHATSAPP"
  status              String   @default("Inactive") // "Active" or "Inactive"
  
  // Public keys/identifiers
  accountSid          String?  // Twilio Account SID or Meta WhatsApp Phone ID
  senderId            String?  // Twilio Number/Service SID or Meta WhatsApp Account ID
  
  // Encrypted Keys
  encryptedAuthToken  String?  @db.Text // Encrypted Twilio Token or WhatsApp System Token
  encryptionIv        String?  // IV used for GCM encryption

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("company_integrations")
}


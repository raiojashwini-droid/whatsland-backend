generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  roleId              String
  status              String           @default("Active")
  lastLogin           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  companyId           String?
  auditLogs           AuditLog[]
  assignedInspections Inspection[]     @relation("InspectorRelation")
  assignments         UserAssignment[]
  company             Company?         @relation(fields: [companyId], references: [id])
  role                Role             @relation(fields: [roleId], references: [id])

  @@index([companyId], map: "users_companyId_fkey")
  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?      @db.Text
  isCustom    Boolean      @default(false)
  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id         String  @id @default(uuid())
  roleId     String
  module     String
  canView    Boolean @default(false)
  canCreate  Boolean @default(false)
  canEdit    Boolean @default(false)
  canDelete  Boolean @default(false)
  canApprove Boolean @default(false)
  canExport  Boolean @default(false)
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("permissions")
}

model UserAssignment {
  id         String  @id @default(uuid())
  userId     String
  propertyId String?
  buildingId String?
  unitId     String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_assignments_userId_fkey")
  @@map("user_assignments")
}

model Owner {
  id                   String              @id @default(uuid())
  email                String              @unique
  phone                String
  payoutMethod         String              @default("ACH/Direct Deposit")
  propertiesOwnedCount Int                 @default(0)
  createdAt            DateTime            @default(now())
  streetAddress        String?
  companyId            String?
  companyName          String?
  name                 String              @default("")
  distributions        OwnerDistribution[]
  company              Company?            @relation(fields: [companyId], references: [id])
  properties           Property[]

  @@index([companyId], map: "owners_companyId_fkey")
  @@map("owners")
}

model Property {
  id                  String        @id @default(uuid())
  name                String
  type                PropertyType  @default(Apartment)
  status              String        @default("Active")
  ownerId             String
  ownershipPercentage Float         @default(100)
  managementCompany   String        @default("Apex Property Management")
  address             String
  streetAddress       String
  city                String
  state               String
  country             String        @default("USA")
  zip                 String
  unitsCount          Int           @default(0)
  occupiedUnits       Int           @default(0)
  occupancyRate       Float         @default(0)
  monthlyRevenue      Float         @default(0)
  yearBuilt           Int
  totalBuildings      Int           @default(1)
  squareFootage       Float
  purchasePrice       Float
  currentValue        Float
  monthlyExpenses     Float         @default(0)
  createdAt           DateTime      @default(now())
  companyId           String?
  nycBin              String?
  imageUrl            String?       @db.Text
  buildings           Building[]
  leases              Lease[]
  company             Company?      @relation(fields: [companyId], references: [id])
  owner               Owner         @relation(fields: [ownerId], references: [id])
  rentPayments        RentPayment[]
  units               Unit[]
  workOrders          WorkOrder[]

  @@index([companyId], map: "properties_companyId_fkey")
  @@index([ownerId], map: "properties_ownerId_fkey")
  @@map("properties")
}

model Building {
  id            String   @id @default(uuid())
  propertyId    String
  name          String
  floors        Int      @default(1)
  unitsCount    Int      @default(0)
  occupancyRate Float    @default(0)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units         Unit[]

  @@index([propertyId], map: "buildings_propertyId_fkey")
  @@map("buildings")
}

model Unit {
  id               String        @id @default(uuid())
  propertyId       String
  buildingId       String
  unitNumber       String
  floor            Int
  bedrooms         Int
  bathrooms        Float
  squareFootage    Float
  rentAmount       Float
  securityDeposit  Float
  availabilityDate DateTime
  status           UnitStatus    @default(Vacant)
  leases           Lease[]
  moveIns          MoveIn[]
  moveOuts         MoveOut[]
  rentPayments     RentPayment[]
  tenants          Tenant[]
  building         Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  violations       Violation[]

  @@index([buildingId], map: "units_buildingId_fkey")
  @@index([propertyId], map: "units_propertyId_fkey")
  @@map("units")
}

model Tenant {
  id                String            @id @default(uuid())
  firstName         String
  lastName          String
  email             String            @unique
  phone             String
  unitId            String?
  status            TenantStatus      @default(Pending)
  createdAt         DateTime          @default(now())
  companyId         String?
  imageUrl          String?           @db.Text
  dob               String?
  nationality       String?
  idType            String?
  idNumber          String?
  emergencyName     String?
  emergencyRelationship String?
  emergencyPhone    String?
  employer          String?
  position          String?
  monthlyIncome     Float?
  employmentStatus  String?
  currentAddress    String?
  charges           Charge[]
  deposits          Deposit[]
  insurancePolicies InsurancePolicy[]
  invoices          Invoice[]
  leases            Lease[]
  paymentPlans      PaymentPlan[]
  payments          RentPayment[]
  screeningReports  ScreeningReport[]
  company           Company?          @relation(fields: [companyId], references: [id])
  unit              Unit?             @relation(fields: [unitId], references: [id])

  @@index([companyId], map: "tenants_companyId_fkey")
  @@index([unitId], map: "tenants_unitId_fkey")
  @@map("tenants")
}

model Lease {
  id            String        @id @default(uuid())
  tenantId      String
  propertyId    String
  unitId        String
  startDate     DateTime
  endDate       DateTime
  rentAmount    Float
  depositAmount Float
  status        LeaseStatus   @default(Pending_Move_In)
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  unit          Unit          @relation(fields: [unitId], references: [id])
  moveIn        MoveIn?
  moveOut       MoveOut?
  renewal       LeaseRenewal?
  payments      RentPayment[]

  @@index([companyId], map: "leases_companyId_fkey")
  @@index([propertyId], map: "leases_propertyId_fkey")
  @@index([tenantId], map: "leases_tenantId_fkey")
  @@index([unitId], map: "leases_unitId_fkey")
  @@map("leases")
}

model RentPayment {
  id              String        @id @default(uuid())
  tenantId        String
  propertyId      String
  unitId          String
  leaseId         String
  amount          Float
  dueDate         DateTime
  paidDate        DateTime?
  status          PaymentStatus @default(Pending)
  paymentMethod   PaymentMethod @default(ACH)
  referenceNumber String?
  createdBy       String        @default("System")
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  lease           Lease         @relation(fields: [leaseId], references: [id])
  property        Property      @relation(fields: [propertyId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  unit            Unit          @relation(fields: [unitId], references: [id])

  @@index([companyId], map: "rent_payments_companyId_fkey")
  @@index([leaseId], map: "rent_payments_leaseId_fkey")
  @@index([propertyId], map: "rent_payments_propertyId_fkey")
  @@index([tenantId], map: "rent_payments_tenantId_fkey")
  @@index([unitId], map: "rent_payments_unitId_fkey")
  @@map("rent_payments")
}

model CoAAccount {
  id           String             @id @default(uuid())
  accountCode  String             @unique
  accountName  String
  type         String
  subType      String?
  balance      Float              @default(0)
  isActive     Boolean            @default(true)
  companyId    String?
  company      Company?           @relation(fields: [companyId], references: [id])
  journalLines JournalEntryLine[]

  @@index([companyId], map: "coa_accounts_companyId_fkey")
  @@map("coa_accounts")
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique
  date        DateTime
  description String             @db.Text
  reference   String?
  companyId   String?
  company     Company?           @relation(fields: [companyId], references: [id])
  lines       JournalEntryLine[]

  @@index([companyId], map: "journal_entries_companyId_fkey")
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Float        @default(0)
  credit         Float        @default(0)
  account        CoAAccount   @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "journal_entry_lines_accountId_fkey")
  @@index([journalEntryId], map: "journal_entry_lines_journalEntryId_fkey")
  @@map("journal_entry_lines")
}

model Vendor {
  id          String      @id @default(uuid())
  companyName String
  contactName String
  email       String
  phone       String
  serviceType String
  rating      Float       @default(5)
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id])
  workOrders  WorkOrder[]

  @@index([companyId], map: "vendors_companyId_fkey")
  @@map("vendors")
}

model WorkOrder {
  id              String             @id @default(uuid())
  propertyId      String
  title           String
  description     String             @db.Text
  vendorId        String?
  priority        Priority           @default(Normal)
  status          work_orders_status @default(Open)
  estimatedCost   Float?
  actualCost      Float?
  labourCost      Float?
  materialsCost   Float?
  extraExpenses   Float?
  createdAt       DateTime           @default(now())
  rejectReason    String?            @db.Text
  resolutionNotes String?            @db.Text
  companyId       String?
  company         Company?           @relation(fields: [companyId], references: [id])
  property        Property           @relation(fields: [propertyId], references: [id])
  vendor          Vendor?            @relation(fields: [vendorId], references: [id])

  @@index([companyId], map: "work_orders_companyId_fkey")
  @@index([propertyId], map: "work_orders_propertyId_fkey")
  @@index([vendorId], map: "work_orders_vendorId_fkey")
  @@map("work_orders")
}

model OwnerDistribution {
  id            String   @id @default(uuid())
  ownerId       String
  period        String
  amount        Float
  status        String   @default("Completed")
  processedDate DateTime @default(now())
  owner         Owner    @relation(fields: [ownerId], references: [id])

  @@index([ownerId], map: "owner_distributions_ownerId_fkey")
  @@map("owner_distributions")
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String?
  action    String
  module    String
  object    String
  ip        String
  status    String   @default("Success")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "audit_logs_userId_idx")
  @@map("audit_logs")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String   @default("General")
  author    String   @default("Property Management")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "announcements_companyId_fkey")
  @@map("announcements")
}

model InsurancePolicy {
  id             String   @id @default(uuid())
  tenantId       String
  policyNumber   String
  provider       String
  coverageAmount Float
  startDate      DateTime
  endDate        DateTime
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "insurance_policies_companyId_fkey")
  @@index([tenantId], map: "insurance_policies_tenantId_fkey")
  @@map("insurance_policies")
}

model Promotion {
  id        String   @id @default(uuid())
  code      String   @unique
  discount  String
  duration  String
  used      Int      @default(0)
  maxUses   Int      @default(100)
  status    String   @default("Active")
  createdAt DateTime @default(now())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "promotions_companyId_fkey")
  @@map("promotions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  role      String   @default("Property Manager")
  title     String
  message   String   @db.Text
  type      String   @default("info")
  read      Boolean  @default(false)
  targetId  String?
  targetUrl String?
  createdAt DateTime @default(now())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "notifications_companyId_fkey")
  @@map("notifications")
}

model Document {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("General")
  fileUrl    String
  fileSize   String   @default("1.2 MB")
  uploadedBy String   @default("Property Manager")
  createdAt  DateTime @default(now())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "documents_companyId_fkey")
  @@map("documents")
}

model AiChatLog {
  id        String   @id @default(uuid())
  userId    String?
  prompt    String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "ai_chat_logs_companyId_fkey")
  @@map("ai_chat_logs")
}

model BankAccount {
  id            String   @id @default(uuid())
  name          String
  institution   String
  accountNumber String
  balance       Float    @default(0)
  type          String
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "bank_accounts_companyId_fkey")
  @@map("bank_accounts")
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  planName     String
  price        Float
  billingCycle String
  nextInvoice  DateTime
  usageLimit   String
  createdAt    DateTime @default(now())

  @@map("subscription_plans")
}

model SecurityPolicy {
  id             String  @id @default(uuid())
  mfaRequired    Boolean @default(true)
  sessionTimeout Int     @default(30)
  passwordPolicy String  @default("Strong")
  ipWhitelist    String  @default("192.168.1.0/24")

  @@map("security_policies")
}

model PaymentPlan {
  id          String   @id @default(uuid())
  tenantId    String
  totalAmount Float
  frequency   String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "payment_plans_tenantId_fkey")
  @@map("payment_plans")
}

model CrmLead {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String
  source        String
  status        String   @default("New")
  createdAt     DateTime @default(now())
  assignedAgent String?
  budget        Float?
  companyId     String?
  moveInDate    String?
  notes         String?  @db.Text
  priority      String?  @default("Medium")
  property      String?

  @@map("crm_leads")
}

model ScreeningReport {
  id           String   @id @default(uuid())
  tenantId     String
  creditScore  Int      @default(0)
  criminalPass Boolean  @default(true)
  evictionPass Boolean  @default(true)
  status       String   @default("Pending Documents")
  documentUrl  String?  @db.Text
  documentName String?
  dob          String?
  ssn          String?
  authorized   Boolean? @default(false)
  createdAt    DateTime @default(now())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "screening_reports_companyId_fkey")
  @@index([tenantId], map: "screening_reports_tenantId_fkey")
  @@map("screening_reports")
}

model Violation {
  id          String   @id @default(uuid())
  unitId      String
  title       String
  description String   @db.Text
  fineAmount  Float    @default(0)
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "violations_companyId_fkey")
  @@index([unitId], map: "violations_unitId_fkey")
  @@map("violations")
}

model Application {
  id            String   @id @default(uuid())
  tenantName    String
  email         String
  propertyName  String
  unitNumber    String
  status        String   @default("Pending")
  submittedDate DateTime @default(now())
  rentProposed  Float
  createdAt     DateTime @default(now())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "applications_companyId_fkey")
  @@map("applications")
}

model Invoice {
  id           String   @id @default(uuid())
  tenantId     String
  tenantName   String
  propertyId   String
  propertyName String
  unitNumber   String   @default("")
  dueDate      String
  amount       Float
  paidAmount   Float    @default(0)
  balance      Float
  status       String   @default("Draft")
  lineItems    String   @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([companyId], map: "invoices_companyId_fkey")
  @@index([tenantId], map: "invoices_tenantId_fkey")
  @@map("invoices")
}

model ServiceRequest {
  id                 String   @id @default(uuid())
  title              String
  description        String   @db.Text
  propertyId         String
  propertyName       String
  unitNumber         String   @default("")
  tenantId           String?
  tenantName         String
  priority           String   @default("Normal")
  status             String   @default("New")
  category           String   @default("General")
  assignedVendorId   String?
  assignedVendorName String?
  assignedTechnician String?
  estimatedCost      Float?
  cost               Float?
  labourCost         Float?
  extraExpenses      Float?
  scheduledDate      String?
  notes              String?  @db.Text
  messages           String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "service_requests_companyId_fkey")
  @@map("service_requests")
}

model Company {
  id                  String               @id @default(uuid())
  name                String
  code                String               @unique
  contactName         String
  email               String               @unique
  phone               String
  planName            String               @default("14-Day Free Trial")
  planType            String               @default("FREE_TRIAL") // "FREE_TRIAL", "MONTHLY", "YEARLY"
  trialEndsAt         DateTime?
  planEndsAt          DateTime?
  graceEndsAt         DateTime?
  maxProperties       Int                  @default(999999)
  maxUnits            Int                  @default(999999)
  storageUsed         String               @default("1.2 GB")
  status              String               @default("Active")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiChatLogs          AiChatLog[]
  announcements       Announcement[]
  applications        Application[]
  bankAccounts        BankAccount[]
  coaAccounts         CoAAccount[]
  users               CompanyUser[]
  documents           Document[]
  inspectionTemplates InspectionTemplate[]
  inspections         Inspection[]
  insurancePolicies   InsurancePolicy[]
  invoicesPm          Invoice[]
  journalEntries      JournalEntry[]
  leases              Lease[]
  moveIns             MoveIn[]
  moveOuts            MoveOut[]
  notifications       Notification[]
  owners              Owner[]
  promotions          Promotion[]
  properties          Property[]
  payments            RentPayment[]
  invoices            SaaSInvoice[]
  reports             ScreeningReport[]
  serviceReqs         ServiceRequest[]
  staff               StaffProfile[]
  tenants             Tenant[]
  portalUsers         User[]
  vendors             Vendor[]
  violations          Violation[]
  workOrders          WorkOrder[]
  ownerDocuments      OwnerDocument[]
  tenantDocuments     TenantDocument[]
  integrations        CompanyIntegration[]

  @@map("companies")
}

model CompanyUser {
  id        String   @id @default(uuid())
  companyId String
  name      String
  email     String   @unique
  role      String   @default("Admin")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "company_users_companyId_fkey")
  @@map("company_users")
}

model SaaSPlan {
  id            String   @id @default(uuid())
  name          String   @unique
  price         Float
  billingCycle  String   @default("Monthly")
  maxProperties Int      @default(999999)
  maxUnits      Int      @default(999999)
  features      String   @db.Text
  createdAt     DateTime @default(now())

  @@map("saas_plans")
}

model SaaSInvoice {
  id            String    @id @default(uuid())
  companyId     String
  companyName   String
  planType      String?   @default("FREE_TRIAL")
  amount        Float
  status        String    @default("Paid")
  dueDate       DateTime
  paidDate      DateTime?
  transactionId String?
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "saas_invoices_companyId_fkey")
  @@map("saas_invoices")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model OwnerDocument {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("Statements")
  size       String   @default("1.2 MB")
  uploadedAt DateTime @default(now())
  fileUrl    String?
  companyId  String?
  ownerId    String?
  propertyId String?
  company    Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "owner_documents_companyId_fkey")
  @@map("owner_documents")
}

model OwnerMessage {
  id        String   @id @default(uuid())
  sender    String
  recipient String
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@map("owner_messages")
}

model TenantDocument {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("Leasing")
  size       String   @default("1.5 MB")
  uploadedAt DateTime @default(now())
  fileUrl    String?
  buildingId String?
  companyId  String?
  propertyId String?
  tenantId   String?
  unitId     String?
  company    Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "tenant_documents_companyId_fkey")
  @@map("tenant_documents")
}

model TenantMessage {
  id        String   @id @default(uuid())
  sender    String
  recipient String
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@map("tenant_messages")
}

model TenantNotification {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("tenant_notifications")
}

model StaffProfile {
  id                 String   @id @default(uuid())
  name               String   @default("Marcus Vance")
  specialist         String   @default("Senior Maintenance Lead")
  email              String   @unique @default("marcus.vance@apexpm.com")
  phone              String   @default("(512) 555-0199")
  role               String   @default("Maintenance Staff")
  assignedProperties String   @default("Sunset Villas, Apex Heights, Lakeside")
  joinedDate         String   @default("January 15th, 2025")
  isAvailable        Boolean  @default(true)
  completedJobs      Int      @default(142)
  avgResponseTime    String   @default("38 Min")
  customerRating     String   @default("4.92 / 5.0")
  createdAt          DateTime @default(now())
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "staff_profiles_companyId_fkey")
  @@map("staff_profiles")
}

model Charge {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  amount    Float
  status    String   @default("Active")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "charges_tenantId_fkey")
  @@map("charges")
}

model Deposit {
  id        String   @id @default(uuid())
  tenantId  String
  amount    Float
  status    String   @default("Held")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "deposits_tenantId_fkey")
  @@map("deposits")
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Float
  date        DateTime @default(now())
  description String   @db.Text
  createdAt   DateTime @default(now())

  @@map("expenses")
}

model MaintenanceRequest {
  id           String   @id @default(uuid())
  title        String
  description  String   @db.Text
  propertyName String
  unitNumber   String
  priority     String   @default("Normal")
  status       String   @default("New")
  createdAt    DateTime @default(now())

  @@map("maintenance_requests")
}

model MoveIn {
  id            String       @id @default(uuid())
  leaseId       String       @unique
  unitId        String
  scheduledDate DateTime
  completedDate DateTime?
  status        MoveInStatus @default(SCHEDULED)
  notes         String?      @db.Text
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  companyId     String?
  inspections   Inspection[]
  company       Company?     @relation(fields: [companyId], references: [id])
  lease         Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "move_ins_companyId_fkey")
  @@index([unitId], map: "move_ins_unitId_fkey")
  @@map("move_ins")
}

model MoveOut {
  id             String                 @id @default(uuid())
  leaseId        String                 @unique
  unitId         String
  scheduledDate  DateTime
  completedDate  DateTime?
  status         MoveOutStatus          @default(SCHEDULED)
  notes          String?                @db.Text
  cancelReason   String?                @db.Text
  cancelledBy    String?
  cancelledAt    DateTime?
  createdBy      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  companyId      String?
  damageItems    DamageReviewItem[]
  inspections    Inspection[]
  depositSummary MoveOutDepositSummary?
  company        Company?               @relation(fields: [companyId], references: [id])
  lease          Lease                  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  unit           Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "move_outs_companyId_fkey")
  @@index([unitId], map: "move_outs_unitId_fkey")
  @@map("move_outs")
}

model DamageReviewItem {
  id               String              @id @default(uuid())
  moveOutId        String
  inspectionItemId String
  roomName         String
  itemLabel        String
  condition        InspectionCondition
  notes            String?             @db.Text
  decision         DamageDecision?
  chargeAmount     Float?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  moveOut          MoveOut             @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  @@index([moveOutId], map: "damage_review_items_moveOutId_fkey")
  @@map("damage_review_items")
}

model MoveOutDepositSummary {
  id              String    @id @default(uuid())
  moveOutId       String    @unique
  originalDeposit Float
  totalCharges    Float     @default(0)
  refundAmount    Float     @default(0)
  notes           String?   @db.Text
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  moveOut         MoveOut   @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  @@map("move_out_deposit_summaries")
}

model InspectionTemplate {
  id          String                   @id @default(uuid())
  name        String
  type        InspectionTemplateType   @default(MOVE_IN)
  description String?                  @db.Text
  active      Boolean                  @default(true)
  createdBy   String?
  createdAt   DateTime                 @default(now())
  companyId   String?
  rooms       InspectionTemplateRoom[]
  company     Company?                 @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "inspection_templates_companyId_fkey")
  @@map("inspection_templates")
}

model InspectionTemplateRoom {
  id         String                   @id @default(uuid())
  templateId String
  name       String
  sortOrder  Int                      @default(0)
  items      InspectionTemplateItem[]
  template   InspectionTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId], map: "inspection_template_rooms_templateId_fkey")
  @@map("inspection_template_rooms")
}

model InspectionTemplateItem {
  id        String                 @id @default(uuid())
  roomId    String
  label     String
  required  Boolean                @default(false)
  sortOrder Int                    @default(0)
  room      InspectionTemplateRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId], map: "inspection_template_items_roomId_fkey")
  @@map("inspection_template_items")
}

model Inspection {
  id                  String           @id @default(uuid())
  status              InspectionStatus @default(DRAFT)
  createdAt           DateTime         @default(now())
  assignedAt          DateTime?
  assignedBy          String?
  assignedInspectorId String?
  cancelReason        String?          @db.Text
  cancelledAt         DateTime?
  cancelledBy         String?
  companyId           String?
  completedAt         DateTime?
  createdBy           String?
  inspectionNumber    String           @unique
  inspectorSignature  String?          @db.Text
  inspectorSignedAt   DateTime?
  managerNotes        String?          @db.Text
  moveInId            String?
  moveOutId           String?
  overallNotes        String?          @db.Text
  startedAt           DateTime         @default(now())
  templateId          String?
  templateName        String
  templateVersion     Int              @default(1)
  tenantSignature     String?          @db.Text
  tenantSignedAt      DateTime?
  type                InspectionType   @default(MOVE_IN)
  updatedAt           DateTime         @updatedAt
  rooms               InspectionRoom[]
  assignedInspector   User?            @relation("InspectorRelation", fields: [assignedInspectorId], references: [id])
  company             Company?         @relation(fields: [companyId], references: [id])
  moveIn              MoveIn?          @relation(fields: [moveInId], references: [id], onDelete: Cascade)
  moveOut             MoveOut?         @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  @@index([assignedInspectorId], map: "inspections_assignedInspectorId_fkey")
  @@index([companyId], map: "inspections_companyId_fkey")
  @@index([moveInId], map: "inspections_moveInId_fkey")
  @@index([moveOutId], map: "inspections_moveOutId_fkey")
  @@map("inspections")
}

model InspectionRoom {
  id           String           @id @default(uuid())
  inspectionId String
  name         String
  sortOrder    Int              @default(0)
  items        InspectionItem[]
  inspection   Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId], map: "inspection_rooms_inspectionId_fkey")
  @@map("inspection_rooms")
}

model InspectionItem {
  id        String               @id @default(uuid())
  roomId    String
  label     String
  required  Boolean              @default(false)
  sortOrder Int                  @default(0)
  condition InspectionCondition?
  notes     String?              @db.Text
  completed Boolean              @default(false)
  room      InspectionRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  photos    InspectionPhoto[]

  @@index([roomId], map: "inspection_items_roomId_fkey")
  @@map("inspection_items")
}

model InspectionPhoto {
  id         String         @id @default(uuid())
  itemId     String
  url        String         @db.Text
  caption    String?
  sortOrder  Int            @default(0)
  uploadedBy String?
  createdAt  DateTime       @default(now())
  item       InspectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId], map: "inspection_photos_itemId_fkey")
  @@map("inspection_photos")
}

model Income {
  id          String   @id @default(uuid())
  category    String
  amount      Float
  date        DateTime @default(now())
  description String   @db.Text
  status      String   @default("Cleared")
  createdAt   DateTime @default(now())

  @@map("incomes")
}

model Signature {
  id             String   @id @default(uuid())
  documentName   String
  documentId     String
  recipientName  String
  recipientEmail String
  status         String   @default("Sent")
  sentAt         DateTime @default(now())
  expiresAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("signatures")
}

